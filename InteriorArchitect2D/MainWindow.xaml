<Window x:Class="InteriorArchitect2D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interior Architect 2D" 
        Height="760" Width="1280"
        MinWidth="800" MinHeight="600"
        Background="#050505" Foreground="#EEEEEE" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="MinimalButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#222222" BorderThickness="0,0,1,0" Background="#0A0A0A" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" >
                <StackPanel Margin="15">
                    <TextBlock Text="TOOLS" Foreground="#666666" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Button x:Name="BtnDrawWall" Content="Draw Wall" Style="{StaticResource MinimalButton}" Click="BtnDrawWall_Click"/>
                    <Button x:Name="BtnPlaceFurniture" Content="Place Furniture" Style="{StaticResource MinimalButton}" Click="BtnPlaceFurniture_Click"/>
                    <Button x:Name="BtnEditMode" Content="Select / Edit" Style="{StaticResource MinimalButton}" Click="BtnEditMode_Click"/>

                    <Separator Background="#222222" Margin="0,20"/>

                    <TextBlock Text="DRAWING OPTIONS" Foreground="#666666" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel x:Name="WallOptionsPanel" Visibility="Visible">
                        <TextBlock Text="Wall thickness (cm):" Foreground="#999999" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbThickness" Margin="0,0,0,15" Background="#111" Foreground="Black" BorderBrush="#333">
                            <ComboBoxItem Content="12 (Partition)" IsSelected="True"/>
                            <ComboBoxItem Content="25 (Load-bearing)"/>
                            <ComboBoxItem Content="40 (External)"/>
                        </ComboBox>

                        <TextBlock Text="Angle snap (Shift):" Foreground="#999999" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbAngles" Margin="0,0,0,15" Background="#111" Foreground="Black" BorderBrush="#333">
                            <ComboBoxItem Content="10°"/>
                            <ComboBoxItem Content="15°" IsSelected="True"/>
                            <ComboBoxItem Content="30°"/>
                            <ComboBoxItem Content="45°"/>
                            <ComboBoxItem Content="90°"/>
                        </ComboBox>

                        <TextBlock Text="Furniture type:" Foreground="#999999" Margin="0,10,0,5"/>
                        <ComboBox x:Name="CmbFurnitureType" Margin="0,0,0,15" Background="#111" Foreground="Black" BorderBrush="#333">
                            <ComboBoxItem Content="Bed (200x160 cm)"/>
                            <ComboBoxItem Content="Desk (120x60 cm)" IsSelected="True"/>
                            <ComboBoxItem Content="Wardrobe (100x60 cm)"/>
                            <ComboBoxItem Content="Round table (100x100 cm)"/>
                            <ComboBoxItem Content="Standard door (90x90 cm)"/>
                        </ComboBox>

                    </StackPanel>

                    <Separator Background="#222222" Margin="0,20"/>

                    <TextBlock Text="PROJECT" Foreground="#666666" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Button x:Name="BtnUndo" Content="Undo" Style="{StaticResource MinimalButton}" Click="BtnUndo_Click"/>
                    <Button x:Name="BtnCenterView" Content="Center View" Style="{StaticResource MinimalButton}" Click="BtnCenterView_Click"/>
                    <Button x:Name="BtnNewSketch" Content="New Sketch" Style="{StaticResource MinimalButton}" Click="BtnNewSketch_Click"/>

                    <TextBlock Text="ZOOM:" Foreground="#666666" FontSize="12" FontWeight="Bold" Margin="0,15,0,5"/>
                    <TextBlock x:Name="TxtZoomValue" Text="100%" Foreground="#AAAAAA" FontSize="16" Margin="0,0,0,10"/>
                    <Button Content="Help (F1)" Style="{StaticResource MinimalButton}" Click="BtnHelp_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" ClipToBounds="True" Background="#050505">

            <TextBlock Text="Project autosave. State will be restored after restart." 
                       Foreground="#444444" FontSize="11" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                       Margin="15,0,0,10" Panel.ZIndex="10"/>

            <Canvas x:Name="Workspace" 
                    Width="4000" Height="3000"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Workspace_MouseLeftButtonDown"
                    MouseMove="Workspace_MouseMove"
                    MouseLeftButtonUp="Workspace_MouseLeftButtonUp"
                    MouseWheel="Workspace_MouseWheel"
                    MouseRightButtonDown="Workspace_MouseRightButtonDown"
                    MouseRightButtonUp="Workspace_MouseRightButtonUp">

                <Canvas.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,50,50"/>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#151515" Thickness="1"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <Canvas.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.8" ShadowDepth="0"/>
                </Canvas.Effect>

                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CanvasTranslation" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </Grid>
    </Grid>
</Window>