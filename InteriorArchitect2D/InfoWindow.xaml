<Window x:Class="InteriorArchitect2D.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls" Height="400" Width="300" 
        Background="#0A0A0A" Foreground="#EEE"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock Text="INSTRUCTIONS" FontSize="18" FontWeight="Bold" Foreground="#64ffda" Margin="0,0,0,15"/>
        <TextBlock Text="LMB: Draw / Select" Margin="0,5" Foreground="#CCC"/>
        <TextBlock Text="RMB: Pan View" Margin="0,5" Foreground="#CCC"/>
        <TextBlock Text="Wheel: Zoom / Rotate Furniture" Margin="0,5" Foreground="#CCC"/>
        <TextBlock Text="Shift: Angle Snap" Margin="0,5" Foreground="#CCC"/>
        <TextBlock Text="X / Y: Mirror Reflection" Margin="0,5" Foreground="#CCC"/>
        <TextBlock Text="Delete: Delete Object" Margin="0,5" Foreground="#CCC"/>
    </StackPanel>
</Window>